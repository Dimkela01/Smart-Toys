# Copy to .env and adjust. Never commit .env (docs/CLAUDE.md §2).

# --- environment ---
ENVIRONMENT=demo                  # demo | pilot | eval
PUBLIC_WEB_URL=http://localhost:3000
LOG_LEVEL=INFO

# --- published ports ---
# Change these if another project on the machine already uses them. They only affect what
# is published on the host; inside the compose network the services keep their own ports.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# The three inference services (M2), published on the host for smoke tests only; the
# app reaches them inside the compose network instead (LLM/STT/TTS_SERVER_URL below).
# Deliberately not 8080/8001/8002: those are the ports the services use *inside* the
# network, and a machine that already shifted API_PORT to 8001 would collide.
LLM_PORT=8090
STT_PORT=8091
TTS_PORT=8092
# the https front door, started by `make https` (it also fills HTTPS_HOST in for you).
# Needed from M2: a microphone only works in a secure context, so a phone cannot record
# over plain http. Keeping it on the LAN rather than a public tunnel also keeps the
# non-commercial Serbian placeholder voice off the open internet (docs/CLAUDE.md §3).
HTTPS_HOST=localhost
HTTPS_PORT=443
HTTP_PORT=80

# --- database ---
POSTGRES_USER=bruno
POSTGRES_PASSWORD=bruno_dev_password
POSTGRES_DB=bruno
# as seen from inside the compose network (the api container)
DATABASE_URL=postgresql+psycopg://bruno:bruno_dev_password@postgres:5432/bruno
# as seen from the host, where pytest runs: keep the port in sync with POSTGRES_PORT above
TEST_DATABASE_URL=postgresql+psycopg://bruno:bruno_dev_password@localhost:5432/bruno_test

# --- redis (login/PIN lockout counters, rate limits) ---
REDIS_URL=redis://redis:6379/0
# as seen from the host, where pytest runs: keep the port in sync with REDIS_PORT above
TEST_REDIS_URL=redis://localhost:6379/15

# --- auth ---
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-at-least-32-characters-long
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CONSENT_VERSION=2026-11-11
# must be true behind TLS; false only for plain-http local development
COOKIE_SECURE=false
# NFR-06 asks for 10/min/IP. Only a reverse proxy we control may be believed about who the
# client is, so leave TRUST_PROXY_HEADERS off until Caddy (or similar) fronts the stack:
# anything else can forge X-Forwarded-For and give itself a fresh bucket per request.
# With it off every request through the dev proxy shares one bucket, which is why
# docker-compose raises the development limit.
AUTH_RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY_HEADERS=false

# --- email (SMTP; Mailpit in development) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=bruno@example.com
# dev convenience: also print verification/reset links to the api console
EMAIL_PRINT_LINKS=true

# --- inference (M2) ---
# Run `make models` once before starting the stack: the three services below resolve
# their own weights through models/registry.yaml and refuse to start without them.
INFERENCE_PROFILE_DEFAULT=server
LLM_SERVER_URL=http://llm:8080
STT_SERVER_URL=http://stt:8001
TTS_SERVER_URL=http://tts:8002
DEVICE_TUNNEL_URL=
DEVICE_TUNNEL_TOKEN=
# left empty, the repo's models/registry.yaml is used; compose overrides it for the container
# MODEL_REGISTRY_PATH=
#
# Which model the LLM serves. Empty means the registry's own `default`; set it to another
# registry id to compare models without editing any code (F-20).
LLM_MODEL_ID=
# two slots of `context` tokens each (ARCHITECTURE.md §6.3)
LLM_PARALLEL=2
# threads for llama-server and faster-whisper. Empty means "every CPU the container
# sees"; set them lower if the laptop needs to stay responsive while the stack runs.
LLM_THREADS=
STT_THREADS=
STT_MODEL_ID=
# Kokoro voice for English: af_heart (female) or am_michael (male) are downloaded
TTS_EN_VOICE=af_heart
# The only Serbian voice that exists is non-commercial and sounds wrong, so the registry
# marks it internal_only. Leave this true for development on the LAN; a public
# deployment must leave it unset, and then Serbian has no voice at all until a recorded
# one replaces it (docs/CLAUDE.md §3, docs/reports/M2.md).
TTS_ALLOW_INTERNAL_ONLY=true

# --- versioned content (characters, avatars, lessons) ---
# left empty, the repo's content/ directory is used; compose overrides it for the container
# CONTENT_DIR=

# --- retention (DATA_MODEL.md §6; jobs arrive in M5) ---
TRANSCRIPT_RETENTION_DAYS=30

# --- first admin (make seed) ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=admin_dev_password
