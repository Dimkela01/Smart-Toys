# Copy to .env and adjust. Never commit .env (docs/CLAUDE.md §2).

# --- environment ---
ENVIRONMENT=demo                  # demo | pilot | eval
PUBLIC_WEB_URL=http://localhost:3000
LOG_LEVEL=INFO

# --- database ---
POSTGRES_USER=bruno
POSTGRES_PASSWORD=bruno_dev_password
POSTGRES_DB=bruno
# host/port as seen from the api container; use localhost:5432 when running the api outside docker
DATABASE_URL=postgresql+psycopg://bruno:bruno_dev_password@postgres:5432/bruno
TEST_DATABASE_URL=postgresql+psycopg://bruno:bruno_dev_password@localhost:5432/bruno_test

# --- redis (login/PIN lockout counters, rate limits) ---
REDIS_URL=redis://redis:6379/0

# --- auth ---
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-at-least-32-characters-long
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CONSENT_VERSION=2026-11-11

# --- email (SMTP; Mailpit in development) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=bruno@localhost
# dev convenience: also print verification/reset links to the api console
EMAIL_PRINT_LINKS=true

# --- inference (not used in M1; wired up in M2) ---
INFERENCE_PROFILE_DEFAULT=server
LLM_SERVER_URL=http://llm:8080
STT_SERVER_URL=http://stt:8001
TTS_SERVER_URL=http://tts:8002
DEVICE_TUNNEL_URL=
DEVICE_TUNNEL_TOKEN=
MODEL_REGISTRY_PATH=models/registry.yaml

# --- retention (DATA_MODEL.md §6; jobs arrive in M5) ---
TRANSCRIPT_RETENTION_DAYS=30

# --- first admin (make seed) ---
ADMIN_SEED_EMAIL=admin@localhost
ADMIN_SEED_PASSWORD=admin_dev_password
